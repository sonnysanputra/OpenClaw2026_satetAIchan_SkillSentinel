# OpenClaw security Gateway (SkillsSentinel agent)
SECURITY_GATEWAY_URL=wss://localhost:18789
SECURITY_GATEWAY_TOKEN=replace-with-gateway-token
SECURITY_AGENT_SESSION=agent:security:main
SECURITY_GATEWAY_LOOPBACK=true

# Frontend CORS origin
FRONTEND_ORIGIN=http://localhost:3000

# Skill registry
SKILLSHUB_README_URL=https://raw.githubusercontent.com/mergisi/awesome-openclaw-agents/main/agents.json
SKILLSHUB_CACHE_TTL=300

# Logging
LOG_LEVEL=info
